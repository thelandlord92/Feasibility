      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//parameters.\nbayWidth;\nbayLength;\nbayAngle;\nbounding_curve_length;\n\n//actual bay width against center line.\nactualWidth = bayWidth / DSCore.Math.Cos(bayAngle);\n\n//calculate number of bays for copying along line.\nbay_copy_number = DSCore.Math.Ceiling(bounding_curve_length / actualWidth);\n\n//create line.\nline = Line.ByStartPointEndPoint(Autodesk.Point.ByCoordinates(),\nAutodesk.Point.ByCoordinates(0,(actualWidth*bay_copy_number),0));\n\n//get line start point coordinate system.\nline_cs = Autodesk.Curve.CoordinateSystemAtParameter (line, 0);\n\n//line start point coordinate system x axis.\ncs_x_axis = line_cs.XAxis;\n\n//create line to place first array of parking bays.\n\t//workout offset dimension.\n\toffset_dim = bayWidth * DSCore.Math.Sin(bayAngle) / 2;\n\t//move center line to offset bays.\n\tmoved_line = Geometry.Translate (line, cs_x_axis, offset_dim);\n\n//bay line location points.\nlocPoints = List.DropItems(Autodesk.Curve.PointAtParameter\n\t(moved_line,0..1..#bay_copy_number+1), -1);\n\n//bay line plane.\nlinePlane = Plane.ByOriginNormal(locPoints,Vector.ZAxis());\n\n//bay line plane coordinate system.\nplaneCS = CoordinateSystem.ByPlane(linePlane);\n\n//line start point.\nstartPoint = Line.StartPoint(line);\n\n//initial parking bay.\niniPark = Geometry.Rotate(Rectangle.ByWidthLength(bayLength,bayWidth),startPoint,\nVector.ZAxis(),bayAngle);\n\n//bay start point.\nbayStart = Autodesk.Curve.StartPoint(iniPark);\n\n//bay plane.\nbayPlane = Plane.ByOriginNormal(bayStart,Vector.ZAxis());\n\n//bay coordinate system.\nbayCS = CoordinateSystem.ByPlane(bayPlane);\n\n//transform bays to line locations.\ntransBays = Geometry.Transform (iniPark,bayCS,planeCS);\n\n//copy the transformed parking bays.\n\t//create the translation  axis.\n\ttrans_axis = Vector.Rotate (cs_x_axis, Vector.ZAxis(), bayAngle);\n\t//copy the parking bays.\n\tcopied_bays = Geometry.Translate (transBays, trans_axis, bayLength);\n\n//combine bays into one list.\ncombined_bays = List.Join ([transBays, copied_bays]);\n\n//mirror pattern.\n\t//create plane for mirroring.\n\tmirror_plane = Plane.ByOriginNormal (startPoint, cs_x_axis);\n\t//mirror bays.\n\tmirror_bays = Geometry.Mirror (combined_bays, mirror_plane);\n\n//rotate combined pattern.\n\t//get rotation center point.\n\trotation_point = line.PointAtParameter (0.5);\n\t//rotate bays type 1.\n\trotated_bays1 = Geometry.Rotate\n\t\t(combined_bays, rotation_point, Vector.ZAxis(), setout_angle);\n\t//rotate bays type 2.\n\trotated_bays2 = Geometry.Rotate\n\t\t(mirror_bays, rotation_point, Vector.ZAxis(), setout_angle);\n\n//calculate overall pattern width.\n\t//width of the pattern from the center overlap zone.\n\tpattern_width_external = DSCore.Math.Cos(bayAngle) * bayLength;\n\t//calculate pattern width.\n\tpattern_width = pattern_width_external * 2 + offset_dim * 2;\n\n\n///****elements for the creation of parking islands****///\n//rotate center line.\nrotated_center_line = Geometry.Rotate\n\t(line, rotation_point, Vector.ZAxis(), setout_angle);\n\n//define rectangular surface covering full parking pattern.\n\t//create center plane.\n\tcenter_plane = Plane.ByOriginNormal\n\t(Autodesk.Curve.PointAtParameter(line, 0.5), Vector.ZAxis());\n\t//create the surface rectangle.\n\tsurface_rectangle = Rectangle.ByWidthLength\n\t\t(center_plane, pattern_width, actualWidth*bay_copy_number);\n\t//rotate the rectangle.\n\trotated_rectangle = Geometry.Rotate\n\t\t(surface_rectangle, rotation_point, Vector.ZAxis(), setout_angle);\n\t//create the pattern surface.\n\tpattern_surface = Autodesk.Surface.ByPatch(rotated_rectangle);\n\n//create elongated parking spots to be used for cutting island geometry.\n\t//workout length to add to the parking bay length.\n\tadditional_length = bayWidth * DSCore.Math.Tan(bayAngle);\n\t//create the initial elongated spot.\n\telongated_spot =\n\t\tGeometry.Rotate(\n\t\t\tRectangle.ByWidthLength((bayLength+additional_length),bayWidth),\n\t\t\tstartPoint,Vector.ZAxis(),bayAngle\n\t\t\t);\n\t//get bay start point.\n\telongated_start = Autodesk.Curve.StartPoint(elongated_spot);\n\t//create plane at start point.\n\tstart_plane = Plane.ByOriginNormal(elongated_start, Vector.ZAxis());\n\t//create coordinate system at the plane.\n\tbay_plane_cs = CoordinateSystem.ByPlane(start_plane);\n\t//transform bays onto centerline locations.\n\ttransform_bays = Geometry.Transform (elongated_spot, bay_plane_cs, planeCS);\n\t//copy the transformed parking bays.\n\tcopy_bays = Geometry.Translate (\n\t\ttransform_bays, trans_axis, (bayLength+additional_length)\n\t\t);\n\t//combine pattern into one list.\n\telongated_pattern = List.Join([transform_bays, copy_bays]);\n\t//mirror the pattern.\n\tmirror_bays2 = Geometry.Mirror (elongated_pattern, mirror_plane);\n\t//rotate the combined pattern.\n\trotated_elongated_bays = Geometry.Rotate\n\t\t(elongated_pattern, rotation_point, Vector.ZAxis(), setout_angle);\n\trotated_elongated_bays2 = Geometry.Rotate\n\t\t(mirror_bays2, rotation_point, Vector.ZAxis(), setout_angle);"
    },
