    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "0501ea95289f4cf4bb2284cf1882aad2",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "31cf01ec64d5461884c216285431aa44",
          "Name": "",
          "Description": "Value of expression at line 1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "false;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the required libraries.\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nclr.AddReference('DSCoreNodes') \r\nimport DSCore\r\nfrom DSCore import *\r\n\r\n# Inputs\r\npoint_list = IN[0]\r\nindex_list = IN[1]\r\n\r\n# Get booleans to check if both sublists in the second list are not empty.\r\nempty_bool =[]\r\nfor list in index_list[1]:\r\n    empty_bool.append(List.IsEmpty(list))\r\n\r\n# Make the original list the point list if all the items are empty.\r\nif False not in empty_bool:\r\n    point_slice = point_list[1]\r\n# Add empty list where necessary to mirror the index list if all items are not empty in second list. \r\nelse:\r\n    point_slice = point_list[1]\r\n    for index, bool in enumerate(empty_bool):\r\n        # Insert an empty list into the point list where the boolean is True.\r\n        if bool == True:\r\n            point_slice.insert(index, List.Empty)\r\n\r\n\r\n# Add each items in the point slice to the end of each list in the point list.\r\nif False not in empty_bool:\r\n    organized_list = []\r\n    for element in point_list[0]:\r\n        # Add an \"empty list\" contained in the point slice to the end of each sublist in the concave corner setout points.\r\n        element.append(point_slice)\r\n        organized_list.append(element)\r\nelse:\r\n    organized_list = []\r\n    for element, item in zip(point_list[0], point_slice):\r\n        if len(item) > 0:\r\n            for sub_item in item:\r\n                element.append(sub_item)\r\n        else:\r\n            element.append(item)\r\n        organized_list.append(element)\r\n\r\nOUT = organized_list\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "9c5347f1f6994dd9b686af3299d22b19",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "65fa472c07f54b859df37d6890009579",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bac943d1aed64157a06cc14d6c9bb03e",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "493f4ba9a5e848c7838823f5316d5b39",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
