    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Inputs\r\nfiltered_aisle_intersecting_spots = IN[0]\r\nfiltered_unusable_spots = IN[1]\r\n# Boolean to check if there are any exclusion zones that intersect with each other.\r\nintersect_bool = IN[2]\r\n\r\n# To choose between the filtered parking spots depending on exclusion zone intersections.\r\nif intersect_bool == True:\r\n    parking_spots = filtered_unusable_spots\r\nelse:\r\n    parking_spots = filtered_aisle_intersecting_spots\r\n    \r\n\r\nOUT = parking_spots",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e1e10c27488c428eb7774bcb4979265a",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e3546326c4ab410eb492ad8a85797c86",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d09ec92ff07e4a688add93fb958d3489",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "be5b6315fff446b1915cc6256c500b2d",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8a8ff3db49494dd8a9c7d2f65629e3fd",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
