    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "e3bf2bf37ba04716bb3815c102c8576e",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "fdb20479f51d4a6cb56d71b0da4ba179",
          "Name": "concave_angle",
          "Description": "concave_angle",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0b293bb8b27e4d84a7983d7adcf944c4",
          "Name": "concave_corner_spacing",
          "Description": "concave_corner_spacing",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ab4bb92a6bfe4e098e93d84ac02b41c5",
          "Name": "parking_bay_length",
          "Description": "parking_bay_length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ea14a9e0b24e43b59c1f58f563348d24",
          "Name": "",
          "Description": "equal_angle",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a0c7aab6a128480eb7e0996e07caceb6",
          "Name": "",
          "Description": "side_length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4701641501e44a508f85016ed845f04c",
          "Name": "",
          "Description": "hypotenuse_length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7f6bf90f89524b429f375137c9dbde34",
          "Name": "",
          "Description": "base_length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e3cbe2bce2a041e78e2fda072fb7a6d8",
          "Name": "",
          "Description": "concave_corner_distance",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//calculate distance for concave corner setout points.\n\t//calculate the equal isosceles angle.\n\tequal_angle = (180 - concave_angle) / 2;\n\n\t//calculate length of side of isoceles triangle.\n\tside_length =\n\tconcave_corner_spacing * DSCore.Math.Sin(equal_angle) /\n\tDSCore.Math.Sin(concave_angle);\n\n\t//calculate the hypotenuse length of parking bay side triangle.\n\thypotenuse_length =\n\tparking_bay_length / DSCore.Math.Cos(90 - concave_angle);\n\n\t//calculate the base length of parking bay side triangle.\n\tbase_length =\n\tparking_bay_length * DSCore.Math.Tan(90 - concave_angle);\n\n\t//concave corner setout distance.\n\tconcave_corner_distance =\n\tside_length + hypotenuse_length + base_length;"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "768fc683bd8240fe986e254b96a1257b",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
