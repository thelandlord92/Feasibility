    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "b88026e18de14761ae94dc7e12a91409",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "1499cb324b1c467fa62ea68f14d034b3",
          "Name": "closedCurve",
          "Description": "Closed curve used as surface boundary\n\nCurve",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "94f15eea93414a35b3651f5eb2dd233a",
          "Name": "Surface",
          "Description": "Surface created by patch",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Surface.ByPatch@Autodesk.DesignScript.Geometry.Curve",
      "Replication": "Auto",
      "Description": "Create a Surface by filling in the interior of a closed boundary defined by input Curves.\n\nSurface.ByPatch (closedCurve: Curve): Surface"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Import the required libraries.\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Inputs.\r\nsite_curve = IN[0]\r\noffset_distance = IN[1]\r\n\r\n# Offset the boundary curve.\r\n# Return the polycurve to singular curve if the user input offset returns two curves.\r\ncurrent_offset = offset_distance\r\nincrement_value = 0.1\r\nmax_attempts = 1000\r\nattempts = 0\r\n\r\nwhile attempts < max_attempts:\r\n    offset_curve = Curve.OffsetMany(site_curve, current_offset, Vector.ZAxis())\r\n    \r\n    # Check if the offset curve list has more than one curve loop:\r\n    if len(offset_curve) == 1:\r\n        returned_curve = offset_curve\r\n        break\r\n    else:\r\n        # Reduce the offset and try again\r\n        current_offset += increment_value  # Adding to the negative value\r\n        attempts += 1\r\n\r\n# Check if a valid offset curve was found:\r\nif 'returned_curve' not in locals():\r\n    raise Exception(\"Could not reduce the curve offset to one loop after multiple attempts\")\r\n\r\nOUT = returned_curve",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b891c95355b94b0d883752b159f1f51f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "044d4c48f7e5477c81227f74f691f246",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0a82789079664728ad92f0a28148a21e",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "50fdd6f74f8d4c5f8652422aa27b1c24",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Import the required libraries.\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Inputs.\r\npolycurve = IN[0]\r\ninternal_fillet_radius = IN[1]\r\nexternal_fillet_radius = IN[2]\r\n\r\n# Add internal fillet to polycurve. Return original if unsuccessful.\r\ntry:\r\n    internal_fillet_curve = PolyCurve.Fillet(polycurve[0], internal_fillet_radius, False)\r\nexcept:\r\n    internal_fillet_curve = polycurve\r\n\r\n\r\n# Add external fillet to polycurve. Return internal fillet curve if unsuccessful.   \r\ntry:\r\n    external_fillet_curve = PolyCurve.Fillet(internal_fillet_curve, external_fillet_radius, True)\r\nexcept:\r\n    external_fillet_curve = internal_fillet_curve\r\n\r\n\r\nOUT = external_fillet_curve\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3d04a585d1814da4a3fa2a9935cdcaf2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "c7c0b964322f410ea5ff7e35e131be97",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
