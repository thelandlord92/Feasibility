    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Inputs\r\n# Input to select between 45, 60 and 90 degree parking bays. \r\nangle_selector = IN[0]\r\n# Input to select between a one-way or two-way aisle. \r\naisle_type_selector = IN[1]\r\n# one-way and two way aisle width inputs.\r\none_way_width = IN[2]\r\ntwo_way_width = IN[3]\r\nperimeter_width = IN[4]\r\n\r\n# provide the aisle width as per the selected angle and aisle type.\r\nif angle_selector != 4 and aisle_type_selector == 1:\r\n    aisle_width = one_way_width \r\nelif angle_selector != 4 and aisle_type_selector == 2:\r\n    aisle_width = two_way_width \r\nelse:\r\n    aisle_width = perimeter_width\r\n    \r\nOUT = aisle_width\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
