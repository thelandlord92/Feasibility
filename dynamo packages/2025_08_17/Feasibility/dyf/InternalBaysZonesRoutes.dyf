        }
      ],
      "Replication": "Disabled",
      "Description": "A function parameter, use with custom nodes.\r\n\r\nYou can specify the type and default value for parameter. E.g.,\r\n\r\ninput : var[]..[]\r\nvalue : bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Import the required libraries.\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n\r\n# Inputs.\r\npolycurves = IN[0]\r\ninternal_fillet_radius = IN[1]\r\nexternal_fillet_radius = IN[2]\r\n\r\n\r\n# Add internal fillet to polycurve. Return original if unsuccessful.\r\ntry:\r\n    internal_fillet_curves = []\r\n    for polycurve in polycurves: \r\n        # Return the filleted polycurve if successful.\r\n        try:\r\n            internal_fillet_curves.append(PolyCurve.Fillet(polycurve, internal_fillet_radius, False))\r\n        # Return the original polycurve if unsuccessful.\r\n        except:\r\n            internal_fillet_curves.append(polycurve)\r\nexcept:\r\n    # Return the original polycurve list if the fillet process is unsuccessful.\r\n    internal_fillet_curves = polycurves\r\n\r\n\r\n\r\n# Add external fillet to polycurve. Return internal fillet curve if unsuccessful.   \r\ntry:\r\n    external_fillet_curves = []\r\n    for polycurve in internal_fillet_curves:\r\n        # Return the filleted polycurve if successful.\r\n        try:\r\n            external_fillet_curves.append(PolyCurve.Fillet(polycurve, external_fillet_radius, True))\r\n        # Return the original polycurve if unsuccessful.\r\n        except:\r\n            external_fillet_curves.append(polycurve)\r\nexcept:\r\n    # Return the internal fillet curves list if the fillet process is unsuccessful.\r\n    external_fillet_curves = internal_fillet_curves \r\n\r\n\r\nOUT = external_fillet_curves\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "4c997932139a4f699e1cd934d16344e2",
      "NodeType": "PythonScriptNode",
