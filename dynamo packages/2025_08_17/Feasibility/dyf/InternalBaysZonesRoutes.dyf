          "Name": "Surface",
          "Description": "Union of surfaces",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Surface.ByUnion@Autodesk.DesignScript.Geometry.Surface[]",
      "Replication": "Auto",
      "Description": "Union a collection of surfaces into one surface. This method might return a polySurface if the resulting union is non-manifold or multi-faced.\n\nSurface.ByUnion (surfaces: Surface[]): Surface"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nclr.AddReference('GeometryColor')\r\nfrom Modifiers import GeometryColor\r\nclr.AddReference('DSCoreNodes') \r\nimport DSCore\r\nfrom DSCore import *\r\n\r\n\r\n# Inputs.\r\noriginal_parking_list = IN[0]\r\nenumerated_parking_list = enumerate(original_parking_list)\r\nreplacement_parking_pattern = IN[1]\r\n# \"1\" for non interlocking, \"2\" for interlocking, \"3\" for mirrored interlocking and \"4\" for herringbone.\r\nparking_pattern_type = IN[2]\r\n# \"1\" for 1-way aisle and \"2\" for 2-way aisle.\r\naisle_type = IN[3]\r\ncontext_coordinate_system = IN[4]\r\noriginal_coordinate_system = IN[5]\r\n\r\n# Copy of the original parking list.\r\ncopy_list = original_parking_list[:]\r\n\r\n\r\n# Replace items in parking list.\r\n\r\n# Keep the parking list as is if the aisle is one-way and the pattern type is non interlocking.\r\nif aisle_type == 1 and parking_pattern_type == 1:\r\n    copy_list = copy_list\r\n# Replace every second row with the replacement pattern if the aisle is two-way and pattern type is non interlocking.\r\nelif aisle_type == 2 and parking_pattern_type == 1:\r\n    for index, item in enumerate(original_parking_list):\r\n        parking_bays = []\r\n        if index % 2 == 1:\r\n            for parking in replacement_parking_pattern:\r\n                parking_bays.append(Geometry.Transform(parking, original_coordinate_system, context_coordinate_system[index]))\r\n                copy_list[index] = parking_bays\r\n# Replace every second row with the replacement pattern if the aisle is one-way and pattern type is interlocking.\r\nelif aisle_type == 1 and parking_pattern_type == 2:\r\n    for index, item in enumerate(original_parking_list):\r\n        parking_bays = []\r\n        if index % 2 == 1:\r\n            for parking in replacement_parking_pattern:\r\n                parking_bays.append(Geometry.Transform(parking, original_coordinate_system, context_coordinate_system[index]))\r\n                copy_list[index] = parking_bays\r\n# Replace every second row with the replacement pattern if the aisle is one-way and pattern type is mirrored interlocking.\r\nelif aisle_type == 1 and parking_pattern_type == 3:\r\n    for index, item in enumerate(original_parking_list):\r\n        parking_bays = []\r\n        if index % 2 == 1:\r\n            for parking in replacement_parking_pattern:\r\n                parking_bays.append(Geometry.Transform(parking, original_coordinate_system, context_coordinate_system[index]))\r\n                copy_list[index] = parking_bays\r\n# Replace every second row with the replacement pattern if the aisle is two-way and pattern type is herringbone.\r\nelif aisle_type == 2 and parking_pattern_type == 4:\r\n    for index, item in enumerate(original_parking_list):\r\n        parking_bays = []\r\n        if index % 2 == 1:\r\n            for parking in replacement_parking_pattern:\r\n                parking_bays.append(Geometry.Transform(parking, original_coordinate_system, context_coordinate_system[index]))\r\n                copy_list[index] = parking_bays\r\n                \r\n              \r\nOUT = copy_list",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "206cba7e797d4d979a4a6e07d97589ac",
      "NodeType": "PythonScriptNode",
      "Inputs": [
