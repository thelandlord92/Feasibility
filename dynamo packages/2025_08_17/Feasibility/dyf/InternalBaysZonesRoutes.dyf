    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Import the required libraries.\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Inputs.\r\npolycurve = IN[0]\r\ninternal_fillet_radius = IN[1]\r\nexternal_fillet_radius = IN[2]\r\n\r\n# Add internal fillet to polycurve. Return original if unsuccessful.\r\ntry:\r\n    internal_fillet_curve = PolyCurve.Fillet(polycurve[0], internal_fillet_radius, False)\r\nexcept:\r\n    internal_fillet_curve = polycurve\r\n\r\n\r\n# Add external fillet to polycurve. Return internal fillet curve if unsuccessful.   \r\ntry:\r\n    external_fillet_curve = PolyCurve.Fillet(internal_fillet_curve, external_fillet_radius, True)\r\nexcept:\r\n    external_fillet_curve = internal_fillet_curve\r\n\r\n\r\nOUT = external_fillet_curve\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "85ffff45c58d4ded977058a66e09b965",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "382ea2e8b0664ab0a5cc5a01fc06c460",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "90bf0af8640d4803a110659cd9be68d5",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b37a46cf15514902ad515c7e37238e49",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e9f1e3437ae74113a39a3b13e83f564f",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
