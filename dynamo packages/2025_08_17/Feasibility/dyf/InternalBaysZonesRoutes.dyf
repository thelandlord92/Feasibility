      ],
      "Outputs": [
        {
          "Id": "dc3d18fd4cca49609fb6eec778da2749",
          "Name": "",
          "Description": "parking_length",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "47135f10443f419d83042de4f87ebb2a",
          "Name": "",
          "Description": "Value of expression at line 6",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//conditional statement to choose between parallel or regular parking lengths.\nparking_length = length_selector == 1? regular_length: parallel_length;\n\n//add the parking length and walkway width to the exclusion zone\n//perimeter aisle width to offset the exclusion area.\nwalkway_width + parking_length + exclusion_perimeter_route_width;"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Import the required libraries.\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Inputs.\r\nsite_curve = IN[0]\r\noffset_distance = IN[1]\r\n\r\n# Offset the boundary curve.\r\n# Return the polycurve to singular curve if the user input offset returns two curves.\r\ncurrent_offset = offset_distance\r\nincrement_value = 0.1\r\nmax_attempts = 1000\r\nattempts = 0\r\n\r\nwhile attempts < max_attempts:\r\n    offset_curve = Curve.OffsetMany(site_curve, current_offset, Vector.ZAxis())\r\n    \r\n    # Check if the offset curve list has more than one curve loop:\r\n    if len(offset_curve) == 1:\r\n        returned_curve = offset_curve\r\n        break\r\n    else:\r\n        # Reduce the offset and try again\r\n        current_offset += increment_value  # Adding to the negative value\r\n        attempts += 1\r\n\r\n# Check if a valid offset curve was found:\r\nif 'returned_curve' not in locals():\r\n    raise Exception(\"Could not reduce the curve offset to one loop after multiple attempts\")\r\n\r\nOUT = returned_curve",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "79b2fb0bd51044b189a53c410152132a",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8a832f414d884c869aeb817f96059456",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "58d88a7e4cf241ef823c800137fbec22",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "681add5638034178a8a932ed38f36829",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
