    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Inputs\r\n# Input to select between 45, 60 and 90 degree parking bays. \r\nangle_selector = IN[0]\r\n# Input to select between a one-way or two-way aisle. \r\naisle_type_selector = IN[1]\r\n# one-way and two way aisle width inputs.\r\none_way_width = IN[2]\r\ntwo_way_width = IN[3]\r\nperimeter_width = IN[4]\r\n\r\n# provide the aisle width as per the selected angle and aisle type.\r\nif angle_selector != 4 and aisle_type_selector == 1:\r\n    aisle_width = one_way_width \r\nelif angle_selector != 4 and aisle_type_selector == 2:\r\n    aisle_width = two_way_width \r\nelse:\r\n    aisle_width = perimeter_width\r\n    \r\nOUT = aisle_width\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0bd41e29a8834308a8148b96b41c1db0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "09bb6d95c30541dcb3146067227426f8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "74fb59e88a984c909ac50dfc8d97ce11",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "eeb06fe4ab85429ea9f83559c37f79f3",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cc544ce9f4c9456ba830f589dcb979e4",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0f13761556c14caf85daecf3a0229499",
          "Name": "IN[4]",
          "Description": "Input #4",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "417294c893b4405f843caefb0fbe70f2",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
