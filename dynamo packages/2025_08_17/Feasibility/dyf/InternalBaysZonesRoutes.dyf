          "Name": "walkway_width",
          "Description": "walkway_width",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5ea06911aea649b0a7faaa1a64d3ba61",
          "Name": "exclusion_perimeter_r...",
          "Description": "exclusion_perimeter_route_width",
          "UsingDefaultValue": false,
