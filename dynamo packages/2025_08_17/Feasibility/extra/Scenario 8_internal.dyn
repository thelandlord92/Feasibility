          "Name": "elongatedParkingPatterns",
          "Description": "the elongated parking patterns for cutting the green surfaces. Feed from the generate patterns node.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9f7f8fb4d3b84f7c9d6315e1db56fa4f",
