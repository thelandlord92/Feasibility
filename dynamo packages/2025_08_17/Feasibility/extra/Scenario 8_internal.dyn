    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "ba3bfc1e-6f50-4f1b-a821-239e7af9349a",
      "FunctionType": "Graph",
      "Id": "e83f99cc1ba54543a7406d5a5f1ef9c3",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "ca3c44f3ca644becb8abffe1c84f1c0d",
          "Name": "concaveCornerRadius",
          "Description": "The vehicle turning radius at the concave corners of the perimeter aisle.\n\ndouble\nDefault value : 3.5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "641ae9b529324d12acc57f0aaa028368",
          "Name": "convexCornerRadius",
          "Description": "The vehicle turning radius at the convex corners of the perimeter aisle.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c54e0d6c92804ae695d644fd22043f4a",
          "Name": "boundaryCurve",
          "Description": "a polycurve representing the boundary of the site area.\n\nPolyCurve",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ecff4be6855a40e89beb31dccbcbbcf3",
          "Name": "bayLength",
          "Description": "the length of the vehicular parking bays.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ed633daf52474d438e780a3da2262842",
          "Name": "perimeterAisleWidth",
          "Description": "the width of the perimeter aisle all round the parking layout.\n\ndouble\nDefault value : 7",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1cfa21bf4f0140c0978cdeb956fcebe2",
          "Name": "internalParkingSurface",
          "Description": "the parking lot surface minus the depth of the perimeter parking bays and perimeter aisle.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4832b57023224efcaf9bde840dc1d483",
          "Name": "perimeterRoadwaySurface",
          "Description": "a surface covering the length of the perimeter spots and the width of the perimeter aisle.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bf98a890ed884f71b5791c7424906c53",
          "Name": "internalBoundaryCurve",
          "Description": "the boundary curve of the internal parking area surface.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Creates the internal parking and roadway surfaces. "
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "023838c1-9305-4b17-839c-6f579dcc52b1",
      "FunctionType": "Graph",
      "Id": "a30a21adc3124ddd92187b54764d92be",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "412844f0a1b0489685289157e35c6613",
          "Name": "degrees",
          "Description": "the degree of rotation to apply to the bounding rectangle\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3cf99e52b278462eba2d2769533a5a3f",
          "Name": "closedCurve",
          "Description": "supply the closed curve to be encapsulated by the rectangle\n\nvar",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "457178d29dd44e4eba322fc20fc7b055",
          "Name": "Rectangle",
          "Description": "the generated bounding rectangle",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4c1a98fdd7c747d4a2dd2796dc3a6e6f",
          "Name": "length",
          "Description": "the length of the rectangle",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c0746c6a75684d599b0d4d354a1b461c",
          "Name": "width",
          "Description": "the width of the rectangle",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Generates a rectangle around a planar closed curve, ensuring the curve is completely encapsulated. "
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "a1585df6-63ab-412c-bbd0-cc224c48e7ef",
      "FunctionType": "Graph",
      "Id": "87c75ed104464bacbb1ad8112bf56ebb",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "2d76c4e4f3264ce1be3d3c63d56a61c1",
          "Name": "patternAngle",
          "Description": "select the parking pattern angle. 1 for 30 degrees, 2 for 45 degrees, 3 for 60 degrees, and 4 for 90 degrees. These angles do no apply to the herringbone pattern which will always be 45 degrees.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2cfc86085b894c47b845c31b37e4fc98",
          "Name": "patternType",
          "Description": "Select \"1\" for the non interlocking pattern which allows for an island between the bay rows, \"2\" for the interlocking pattern, \"3\" for the mirrored interlocking pattern, and \"4\" for the herringbone pattern.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "22818dd318e74b92b3a4c3dff58d8e09",
          "Name": "islandWidth",
