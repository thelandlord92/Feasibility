    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "a1585df6-63ab-412c-bbd0-cc224c48e7ef",
      "FunctionType": "Graph",
      "Id": "9583eb208c624be3958472942a30e234",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "cec075cab4e04a80a643a52c4275a31e",
          "Name": "patternAngle",
          "Description": "select the parking pattern angle. 1 for 30 degrees, 2 for 45 degrees, 3 for 60 degrees, and 4 for 90 degrees. These angles do no apply to the herringbone pattern which will always be 45 degrees.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1b55b18f90494b20add7ebe6728f0d05",
          "Name": "patternType",
          "Description": "Select \"1\" for the non interlocking pattern which allows for an island between the bay rows, \"2\" for the interlocking pattern, \"3\" for the mirrored interlocking pattern, and \"4\" for the herringbone pattern.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ad3405f73bb74b55acdd16e442c03cd3",
          "Name": "islandWidth",
          "Description": "width of the island between the parking rows of the regular parking pattern.\n\ndouble\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c035b194b47e4a95aed005962182ab54",
          "Name": "internalRotation",
          "Description": "the rotation of value of the internal parking bays.\n\ndouble\nDefault value : 45",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2d2c4e433bc9438bbffdbcfa589d0561",
          "Name": "bayWidth",
          "Description": "the width of the vehicular parking bays.\n\ndouble\nDefault value : 2.5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "149954b84d534212ad62edb7efc5e0ff",
          "Name": "bayLength",
          "Description": "the length of the vehicular parking bays.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8af1da1cbb5747df8cfcc95faa5751a4",
          "Name": "rectangleLength",
          "Description": "the length of the bounding rectangle\n\ndouble\nDefault value : 20",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "2c5b676351344cff96233363c1595135",
          "Name": "elongatedParkingPatterns",
          "Description": "the elongated parking patterns for cutting the green surfaces.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
