          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "35fb08f405404804bd7b9d411108e89a",
          "Name": "perimeterAisleWidth",
          "Description": "the width of the perimeter aisle all round the parking layout.\n\ndouble\nDefault value : 7",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1f9aac5f6bb745f1b87464fe08be6102",
          "Name": "patternCenterLine",
