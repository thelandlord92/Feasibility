    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "5db6db72-9c38-4282-8106-629f5abae750",
      "FunctionType": "Graph",
      "Id": "ce0c62a4d6ee4edfb2d7b6134fd58302",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "2b0186db5cf84a23a24783afc1ef97d4",
          "Name": "bayLength",
          "Description": "the length of the vehicular parking bays.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8317aae285a94b4dbb0c829a864b7b44",
          "Name": "boundarySurface",
          "Description": "the input surface defining the parking area.\n\nSurface",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "112a475d85724b26b1726bb2e026060e",
          "Name": "convexCornerRadius",
          "Description": "the radial value at the convex corners of the perimeter spot layout.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "16d8c8a9bf654752ab4b4ae35d5e5649",
          "Name": "exclusionZoneAisleWidth",
          "Description": "the width of the exclusion zone perimeter aisle.\n\ndouble\nDefault value : 7",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e2858c49a020451a85d56766dfb68eb7",
          "Name": "bayWidth",
          "Description": "the width of the vehicular parking bays.\n\ndouble\nDefault value : 2.5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "181d80da6a144e95970884d1c9e44ddb",
          "Name": "convexCornerSpacing",
          "Description": "the distance of the parking bays from the convex corners.\n\ndouble\nDefault value : 3",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c727b415a8244660b529a48f70e32f47",
          "Name": "concaveCornerSpacing",
          "Description": "the distance of the parking bays from the concave corners.\n\ndouble\nDefault value : 4",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e334412a418e493881445bf0704efb07",
          "Name": "basePlane",
          "Description": "the baseplane that hosts the parking elements.\n\nPlane\nDefault value : Autodesk.DesignScript.Geometry.Plane.ByOriginNormal(Autodesk.DesignScript.Geometry.Point.ByCoordinates(), Autodesk.DesignScript.Geometry.Vector.ZAxis())",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "aa38c7ef16e746f7b9fb0a55c7e0fb20",
          "Name": "exclusionZone",
          "Description": "surface geometry representing the exclusion zones.\n\nvar[]..[]\nDefault value : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "c478ef96c59b445abbb98c9b9e356c89",
          "Name": "rotationAngle",
          "Description": "the rotation angle for the parking bays loaded into the Revit model.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "211410ee535b4d73b56bb870a90d8118",
          "Name": "internalSurface",
          "Description": "surface depicting an offset from the complete parking layout, equivalent to the length of the parking spots.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "521e9a0c47a64f6f841c606bbcada2b1",
          "Name": "greenSurface",
          "Description": "the surface representing areas with no parking at the perimeter.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f7f2cb07d3ef4cb98380170e4c5c2db6",
          "Name": "parkingSpots",
          "Description": "rectangles representing the parking spots.",
