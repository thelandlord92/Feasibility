        },
        {
          "Id": "95990807ad3344bdb177638a31a92ee8",
          "Name": "replacementElongatedPattern",
          "Description": "for pattern replacements as required to account for 1-way or 2-way traffic between rows. Used for cutting the green surfaces. Feed from the generate patterns node.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": true,
          "KeepListStructure": false
        },
        {
          "Id": "22cfc1a4b85945bb9884ea158cc0bbd6",
          "Name": "patternType",
          "Description": "select \"1\" for the non interlocking pattern which allows for an island between the bay rows, \"2\" for the interlocking pattern, \"3\" for the mirrored interlocking pattern, and \"4\" for the herringbone pattern.\n\nint\nDefault value : 1",
