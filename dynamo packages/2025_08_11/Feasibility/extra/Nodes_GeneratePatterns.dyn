      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "3e4a5a984dde4aca997317cd6b0766d6",
          "Name": "patternAngle",
          "Description": "select the parking pattern angle. 1 for 30 degrees, 2 for 45 degrees, 3 for 60 degrees, and 4 for 90 degrees. These angles do no apply to the herringbone pattern which will always be 45 degrees.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3c2f181daf084e9c93c97088a89fd893",
          "Name": "patternType",
          "Description": "Select \"1\" for the non interlocking pattern which allows for an island between the bay rows, \"2\" for the interlocking pattern, \"3\" for the mirrored interlocking pattern, and \"4\" for the herringbone pattern.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b9a5bb8065c24f6a89b7131a3c1f75f1",
          "Name": "islandWidth",
          "Description": "width of the island between the parking rows of the regular parking pattern.\n\ndouble\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3f925c4d3d2646b795f4dfd84ea5504d",
          "Name": "internalRotation",
          "Description": "the rotation of value of the internal parking bays.\n\ndouble\nDefault value : 45",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "171efc2a964a4e4f855edeb16e1d1292",
          "Name": "bayWidth",
          "Description": "the width of the vehicular parking bays.\n\ndouble\nDefault value : 2.5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "94ae94baf4fb4c68b9f03a1f5ef85978",
          "Name": "bayLength",
          "Description": "the length of the vehicular parking bays.\n\ndouble\nDefault value : 5",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "18aae8ce426d48b08fc7f548b8dcf44a",
          "Name": "rectangleLength",
          "Description": "the length of the bounding rectangle\n\ndouble\nDefault value : 20",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "66745d5c26ee485480cb41d3c6df1d49",
          "Name": "elongatedParkingPatterns",
          "Description": "the elongated parking patterns for cutting the green surfaces.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "86747f8a82d04098b24dd4c5cf8d32b1",
          "Name": "greenAreaSurfaces",
          "Description": "the full green area surfaces before cutting.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1711b6683d964d988efe5301f26b5885",
          "Name": "replacementElongatedPattern",
          "Description": "for pattern replacements as required to account for 1-way or 2-way traffic between rows. Used for cutting the green surfaces.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8ad3f1ac58194610a73deebe925f73f2",
          "Name": "patternWidth",
          "Description": "the overall width of the parking pattern.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8169e288329e4f6db772a796a85dc599",
          "Name": "patternCenterLine",
          "Description": "the pattern center line.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e366a2d59bbe4335910c4d1cd23524b2",
          "Name": "parkingPattern",
          "Description": "the parking pattern.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "005c03d7740e45d297e45ec63c565fbe",
          "Name": "replacementPattern",
          "Description": "for pattern replacements as required to account for 1-way or 2-way traffic between rows.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Creates the parking patterns."
    }
