        {
          "Id": "49ec406ea3194c998592d0386678e98f",
          "Name": "replacementElongatedPattern",
          "Description": "for pattern replacements as required to account for 1-way or 2-way traffic between rows. Used for cutting the green surfaces. Feed from the generate patterns node.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": true,
          "KeepListStructure": false
        },
        {
          "Id": "4dc0e0bef2dd49388efe214e1798d5cc",
          "Name": "patternType",
          "Description": "select \"1\" for the non interlocking pattern which allows for an island between the bay rows, \"2\" for the interlocking pattern, \"3\" for the mirrored interlocking pattern, and \"4\" for the herringbone pattern.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2dd980c716bf4279a9cdac2e4a17d906",
          "Name": "aisleTypeSelector",
          "Description": "select \"1\" for one way traffic, and \"2\" for two way traffic. The one way aisle is 4400mm wide and the two way aisle is 5400mm wide. The aisle width will be 7000mm for one way and two way if the parking bay angle is 90 degrees. \n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "77bdbfd11c8e4904b8138b00da44641a",
          "Name": "patternAngle",
          "Description": "select \"1\" for 30 degree parking, \"2\" for 45 degree parking, \"3\" for 60 degree parking, and \"4\" for 90 degree parking. Note that the angles are not applied to the perimeter parking bays and herringbone pattern. The herringbone pattern will always be at 45 degrees.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d20aaa134081492492c5aaa7c45d7441",
          "Name": "boundingRectangle",
          "Description": "the bounding rectangle of the internal parking surface. Feed from the generate bounding rectangle node.\n\nPolyCurve",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cf9a6812ff784b3a8ac4713f3fc587a6",
          "Name": "patternWidth",
          "Description": "the overall width of the parking pattern. Feed from the generate patterns node.\n\ndouble",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "35c65c32deea4c5f9351ad241692db6c",
          "Name": "replacementPattern",
          "Description": "for pattern replacements as required to account for 1-way or 2-way traffic between rows. Feed from the generate patterns node.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": true,
          "KeepListStructure": false
        },
        {
          "Id": "f71c3b1d13aa4efdac00523298e3936b",
          "Name": "zoneParkingType",
          "Description": "select \"1\" for regular 90 degree parking along the perimeter of the exclusion area, and \"2\" for parallel parking.\n\nint\nDefault value : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
